2026-10-29T13:17:06.6237663Z for attempt in 1 2 3 4 5; do
2026-10-29T13:17:06.6238241Z   if rustup toolchain install "$toolchain" "${flags[@]}" --profile minimal --no-self-update --force-non-host 2>&1 | tee "$log"; then
2026-10-29T13:17:06.6238862Z     break
2026-10-29T13:17:06.6239089Z   else
2026-10-29T13:17:06.6239300Z     status=$?
